{
  "name": "symphony",
  "displayName": "Symphony",
  "description": "Puts the Symphony App's adoption flow one click away on github.com: create a Symphony repository, or migrate the one you are looking at.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "OpenSpineConsortium",
  "homepage": "https://openspineconsortium.com/symphony/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "wxt prepare",
    "build": "wxt build -b chrome",
    "build:dev": "wxt build -b chrome --mode development",
    "dev": "wxt --mode development",
    "zip": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/build-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "linkedom": "0.18.13",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  }
}
